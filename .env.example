# Copy to .env for local development. Never commit a real .env.
# In Azure these values come from Managed Identity + Key Vault references, not from env files.

# --- API ---
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins for the SPA
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Local dev uses username/password; production uses Entra ID token auth via Managed Identity.
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker

# --- Redis (session cache, rate limiting, websocket fan-out) ---
REDIS_URL=redis://localhost:6379/0

# --- Local dev auth stub ---
# The stub mints short-lived HS256 tokens that mimic the shape of Entra ID access tokens.
# This secret exists ONLY for local development. Real deployments validate Entra ID JWTs.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=local-dev-only-not-a-real-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=60

# --- Entra ID (unused while DEV_AUTH_ENABLED=true; wired for the real integration) ---
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=
